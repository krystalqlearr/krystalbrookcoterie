# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email) — used by the enquiry route + discovery/proposal emails
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@krystalbrookcoterie.com
ENQUIRY_FROM_EMAIL=Krystal Brook Coterie <enquiries@send.krystalbrookcoterie.com>
